      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    {
      "name": "duckduckgo",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-duckduckgo"
      ],
      "enabled": true
    },
    {
      "name": "brave-search",
